TASTY_ENV=prod  # the scan requires prod
TASTY_CLIENT_SECRET=your-client-secret
TASTY_REFRESH_TOKEN=your-refresh-token

NETLIFY_AUTH_TOKEN=your-netlify-token  # only for publish-netlify.py

CLOUDFLARE_API_TOKEN=...   # an API token with "Cloudflare Pages: Edit" permission
CLOUDFLARE_ACCOUNT_ID=...  # shown on the Workers & Pages overview page

